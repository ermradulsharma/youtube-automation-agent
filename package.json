    "credentials:setup": "node utils/credential-manager.js setup",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@google/genai": "^2.18.0",
    "axios": "^1.19.0",
    "chalk": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "form-data": "^4.0.6",
    "googleapis": "^176.0.0",
    "inquirer": "^14.1.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "moment": "^2.30.1",
    "node-cron": "^4.6.0",
    "openai": "^7.6.0",
    "playwright": "^1.62.1",
    "replicate": "^1.4.0",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "winston": "^3.19.0"
